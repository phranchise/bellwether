OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
# For the ADK agent (agent_retail.py). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Optional — Langfuse tracing. Leave blank to run with no tracing. Keys from
# https://cloud.langfuse.com (project settings). LANGFUSE_HOST picks the region:
#   US: https://us.cloud.langfuse.com   EU: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
